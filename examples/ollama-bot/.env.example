# Copy to .env and fill in:  cp .env.example .env   (then: npm start)

# --- OpenWA API (used to send replies) ---------------------------------------
OPENWA_URL=http://localhost:2785
# An OpenWA API key with OPERATOR role (printed on first boot / Dashboard > API Keys)
OPENWA_API_KEY=replace-with-your-openwa-api-key

# --- Webhook security --------------------------------------------------------
# Any long random string. Must be IDENTICAL to the `secret` you use when
# creating the webhook in OpenWA (see README step 5).
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- This bot's HTTP server --------------------------------------------------
# The port OpenWA will POST webhooks to. Register http://localhost:3001/ in OpenWA.
BOT_PORT=3001

# --- Ollama ------------------------------------------------------------------
# Local machine (Quadro P2000):   http://localhost:11434
# School server with a bigger GPU: http://YOUR-SCHOOL-SERVER:11434
OLLAMA_URL=http://localhost:11434
# P2000 (5GB) runs 3B models fully on-GPU. Good picks: llama3.2:3b, qwen2.5:3b,
# phi3:mini, gemma2:2b. On a bigger GPU try qwen2.5:7b or llama3.1:8b.
OLLAMA_MODEL=llama3.2:3b

# --- Behaviour ---------------------------------------------------------------
SYSTEM_PROMPT=You are a friendly WhatsApp assistant. Reply concisely in the user's language.
IGNORE_GROUPS=true
HISTORY_TURNS=6
