# Stack environment variables for Portainer.
# In Portainer: Stacks → (your stack) → "Environment variables" — add these there.
# (You can also paste them as a stack .env.) Do NOT commit a filled-in copy.

# --- Set AFTER first boot ----------------------------------------------------
# OpenWA generates a random admin key on first start and prints it in the
# openwa-api container LOGS (and saves it in the openwa-data volume). Copy it
# here, then redeploy/update the stack so the bot can send replies.
OPENWA_API_KEY=

# --- Set now -----------------------------------------------------------------
# Any long random string. Reuse the SAME value when you register the webhook.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Model the bot uses; pulled automatically on deploy. P2000-friendly default.
# Bigger GPU? try qwen2.5:7b or llama3.1:8b.
OLLAMA_MODEL=llama3.2:3b

# --- Optional ----------------------------------------------------------------
SYSTEM_PROMPT=You are a friendly WhatsApp assistant. Reply concisely in the user's language.
IGNORE_GROUPS=true

# Host port (localhost-only on the server) for the one-time QR scan / Swagger.
API_PORT=2785
